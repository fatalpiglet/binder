; ║  Doctor Binder — настройки Telegram (шаблон)                     ║
; ╚══════════════════════════════════════════════════════════════════╝
; 1) Скопируйте этот файл и переименуйте копию в:  telegram.ini
; 2) Вставьте туда свои значения вместо примеров ниже.
; 3) Файл telegram.ini НЕ публикуйте в GitHub — он в .gitignore.

[Telegram]
; Токен бота: получите/обновите у @BotFather в Telegram (/revoke)
token=ВАШ_ТОКЕН_СЮДА
; Ваш chat_id (узнать можно у бота @userinfobot)
chat_id=ВАШ_CHAT_ID_СЮДА
